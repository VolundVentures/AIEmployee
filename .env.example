# Claude API
ANTHROPIC_API_KEY=

# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# WhatsApp via Twilio (official API -- no QR codes, no IP blocking)
# Get these from https://console.twilio.com
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# For sandbox: +14155238886 | For production: your Twilio WhatsApp number
TWILIO_WHATSAPP_NUMBER=
# Port for Twilio incoming-message webhook (default: 3001)
WEBHOOK_PORT=3001

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
AGENT_PORT=3001

# ─── XAUUSD Trading Bot (Goldie) ───
# Your WhatsApp JID to receive trading alerts (e.g. 971501234567@s.whatsapp.net)
ALERT_PHONE=
# How often to run the heartbeat analysis in minutes (default: 15)
# Each heartbeat: fetches market data, runs AI analysis with memory context, sends via WhatsApp
HEARTBEAT_INTERVAL_MINS=15
# Twelve Data API key (free tier: 800 req/day) -- optional, falls back to Yahoo Finance
TWELVE_DATA_API_KEY=
