# ─── Goldie — XAUUSD Trading Bot ───

# Claude API key (required)
ANTHROPIC_API_KEY=

# WhatsApp via Twilio (required for alerts)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=+14155238886
WEBHOOK_PORT=3001

# Your WhatsApp JID to receive trading alerts (e.g. 971501234567@s.whatsapp.net)
ALERT_PHONE=

# How often to run heartbeat analysis in minutes (default: 15)
HEARTBEAT_INTERVAL_MINS=15

# Twelve Data API key (free tier: 800 req/day) — optional, falls back to Yahoo Finance
TWELVE_DATA_API_KEY=

# ─── Trading Account Config ───

# Account size in USD (default: 1000)
ACCOUNT_SIZE=1000
# Position size in lots (default: 0.02)
LOT_SIZE=0.02
# Risk percentage per trade (default: 1)
RISK_PERCENT=1

# ─── Memory Persistence ───
# Set to a UUID to enable memory persistence across restarts
# Generate one: node -e "console.log(crypto.randomUUID())"
EMPLOYEE_ID=
